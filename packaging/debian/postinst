#!/bin/sh
set -e

if ! getent group intune-zabbix >/dev/null 2>&1; then
    addgroup --system intune-zabbix >/dev/null
fi

if ! getent passwd intune-zabbix >/dev/null 2>&1; then
    adduser --system \
        --ingroup intune-zabbix \
        --home /nonexistent \
        --no-create-home \
        --shell /usr/sbin/nologin \
        intune-zabbix >/dev/null
fi

if [ -f /etc/intune-zabbix-bridge/bridge.env ]; then
    chown root:intune-zabbix /etc/intune-zabbix-bridge/bridge.env
    chmod 0640 /etc/intune-zabbix-bridge/bridge.env
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

printf "\nIntune-Zabbix-Bridge installed.\n"
printf "Zabbix widget: INTUNE — Reboot Watch\n"
printf "Open Zabbix: Administration -> General -> Modules -> Scan directory\n"
printf "Enable the widget module and refresh the browser.\n"
printf "Collector config: /etc/intune-zabbix-bridge/bridge.env\n"
printf "The collector timer is not automatically enabled until configuration is supplied.\n"

exit 0
