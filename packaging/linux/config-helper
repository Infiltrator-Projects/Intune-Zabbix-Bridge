#!/usr/bin/env python3
"""Privileged configuration writer for Intune-Zabbix-Bridge.

Invoked only through pkexec by the GTK setup utility.
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import tempfile

DEST = "/etc/intune-zabbix-bridge/bridge.env"
ALLOWED = {
    "AZURE_TENANT_ID",
    "AZURE_CLIENT_ID",
    "AZURE_CLIENT_SECRET",
    "INTUNE_TELEMETRY_SCRIPT_ID",
    "ZABBIX_SERVER",
    "ZABBIX_PORT",
    "ZABBIX_HOST",
    "ZABBIX_SENDER",
    "TIMEZONE",
    "MAX_TELEMETRY_AGE_HOURS",
    "TOP_N",
    "HTTP_TIMEOUT_SECONDS",
    "HTTP_RETRIES",
    "LOG_LEVEL",
}
REQUIRED = {
    "AZURE_TENANT_ID",
    "AZURE_CLIENT_ID",
    "AZURE_CLIENT_SECRET",
    "INTUNE_TELEMETRY_SCRIPT_ID",
}
KEY_RE = re.compile(r"^[A-Z0-9_]+$")


def parse_env(path: str) -> dict[str, str]:
    values: dict[str, str] = {}
    with open(path, "r", encoding="utf-8") as handle:
        for raw in handle:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise ValueError(f"Invalid configuration line: {line}")
            key, value = line.split("=", 1)
            key = key.strip()
            if not KEY_RE.match(key) or key not in ALLOWED:
                raise ValueError(f"Unsupported configuration key: {key}")
            value = value.strip()
            if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
                value = value[1:-1].replace(r'\"', '"')
            values[key] = value

    missing = sorted(key for key in REQUIRED if not values.get(key, "").strip())
    if missing:
        raise ValueError("Missing required values: " + ", ".join(missing))
    return values


def write_env(values: dict[str, str]) -> None:
    os.makedirs(os.path.dirname(DEST), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".bridge.env.", dir=os.path.dirname(DEST))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            for key, value in values.items():
                escaped = value.replace("\\", "\\\\").replace('"', r'\"')
                handle.write(f'{key}="{escaped}"\n')
        shutil.chown(tmp, user="root", group="intune-zabbix")
        os.chmod(tmp, 0o640)
        os.replace(tmp, DEST)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def run(command: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        print("This helper must run as root.", file=sys.stderr)
        return 2
    if len(argv) != 3 or argv[1] != "install":
        print("Usage: config-helper install <environment-file>", file=sys.stderr)
        return 2

    try:
        values = parse_env(argv[2])
        write_env(values)
    except Exception as exc:
        print(f"Configuration error: {exc}", file=sys.stderr)
        return 1

    run(["systemctl", "daemon-reload"])
    timer = run(["systemctl", "enable", "--now", "intune-zabbix-bridge.timer"])
    if timer.returncode != 0:
        print(timer.stdout.strip(), file=sys.stderr)
        return timer.returncode

    service = run(["systemctl", "restart", "intune-zabbix-bridge.service"])
    if service.returncode != 0:
        logs = run(
            [
                "journalctl",
                "-u",
                "intune-zabbix-bridge.service",
                "-n",
                "20",
                "--no-pager",
            ]
        )
        print(
            "Configuration saved, but the first collector run failed.\n\n"
            + logs.stdout.strip(),
            file=sys.stderr,
        )
        return service.returncode

    print("Configuration saved. The collector ran successfully and the 15-minute timer is enabled.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
