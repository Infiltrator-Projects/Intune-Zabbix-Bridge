#!/usr/bin/env python3
from __future__ import annotations
import glob, os, shutil, subprocess, sys, tempfile
from pathlib import Path

DEST = Path("/etc/intune-zabbix-bridge/bridge.env")
PATTERNS = ("/home/*/Downloads/intune-zabbix-bridge.env", "/root/Downloads/intune-zabbix-bridge.env")
REQUIRED = ("AZURE_TENANT_ID","AZURE_CLIENT_ID","AZURE_CLIENT_SECRET","INTUNE_TELEMETRY_SCRIPT_ID")
OPTIONAL = {"ZABBIX_SERVER","ZABBIX_PORT","ZABBIX_HOST","ZABBIX_SENDER","TIMEZONE","MAX_TELEMETRY_AGE_HOURS","TOP_N","HTTP_TIMEOUT_SECONDS","HTTP_RETRIES","LOG_LEVEL"}
ALLOWED = set(REQUIRED) | OPTIONAL

def parse_file(path: Path) -> dict[str, str]:
    values = {}
    for raw in path.read_text(encoding="utf-8-sig").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise ValueError(f"Invalid line: {line}")
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        if key not in ALLOWED:
            raise ValueError(f"Unsupported setting: {key}")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
            value = value[1:-1]
        values[key] = value
    missing = [k for k in REQUIRED if not values.get(k, "").strip()]
    if missing:
        raise ValueError("Missing required setting(s): " + ", ".join(missing))
    return values

def newest_candidate() -> Path | None:
    matches = []
    for pattern in PATTERNS:
        matches.extend(Path(p) for p in glob.glob(pattern))
    return max(matches, key=lambda p: p.stat().st_mtime) if matches else None

def write_canonical(values: dict[str, str]) -> None:
    DEST.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=".bridge.env.", dir=str(DEST.parent))
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            for key in REQUIRED:
                value = values[key].replace("\\", "\\\\").replace('"', '\\"')
                handle.write(f'{key}="{value}"\n')
            for key in sorted(OPTIONAL):
                if key in values and values[key] != "":
                    value = values[key].replace("\\", "\\\\").replace('"', '\\"')
                    handle.write(f'{key}="{value}"\n')
        shutil.chown(tmp, user="root", group="intune-zabbix")
        os.chmod(tmp, 0o640)
        os.replace(tmp, DEST)
    finally:
        tmp.unlink(missing_ok=True)

def run(*args: str):
    return subprocess.run(list(args), text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)

def main() -> int:
    source = newest_candidate()
    if source is None:
        print("No intune-zabbix-bridge.env file is waiting in Downloads.")
        return 0
    try:
        values = parse_file(source)
        write_canonical(values)
    except Exception as exc:
        print(f"Configuration import failed: {exc}", file=sys.stderr)
        return 1
    source.unlink(missing_ok=True)
    run("systemctl", "daemon-reload")
    timer = run("systemctl", "enable", "--now", "intune-zabbix-bridge.timer")
    if timer.returncode != 0:
        print(timer.stdout.strip(), file=sys.stderr)
        return timer.returncode
    first = run("systemctl", "restart", "intune-zabbix-bridge.service")
    if first.returncode != 0:
        print("Configuration imported, but the first collector run failed. See journalctl -u intune-zabbix-bridge.service", file=sys.stderr)
        return first.returncode
    print("Configuration imported and first collection completed successfully.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
