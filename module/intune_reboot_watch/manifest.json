{
  "manifest_version": 2,
  "id": "intune_reboot_watch",
  "type": "widget",
  "name": "INTUNE — Reboot Watch",
  "namespace": "IntuneRebootWatch",
  "version": "0.7.3",
  "author": "Infiltrator Projects",
  "description": "Searchable, sortable Zabbix 7.0 dashboard widget for Microsoft Intune update-ring and reboot telemetry.",
  "actions": {
    "widget.intune_reboot_watch.view": {
      "class": "WidgetView"
    }
  },
  "widget": {
    "size": {
      "width": 72,
      "height": 12
    },
    "js_class": "WidgetIntuneRebootWatch",
    "refresh_rate": 60
  },
  "assets": {
    "css": [
      "widget.css"
    ],
    "js": [
      "class.widget.js"
    ]
  }
}
