{
  "manifest_version": 2,
  "id": "intune_reboot_watch",
  "type": "widget",
  "name": "INTUNE — Reboot Watch",
  "namespace": "IntuneRebootWatch",
  "version": "0.7.6",
  "author": "Infiltrator Projects",
  "description": "Zabbix 7.0 dashboard for Intune update-ring reporting, weekly restart compliance and reboot telemetry.",
  "actions": {
    "widget.intune_reboot_watch.view": {
      "class": "WidgetView"
    }
  },
  "widget": {
    "size": {
      "width": 72,
      "height": 12
    },
    "js_class": "WidgetIntuneRebootWatch",
    "refresh_rate": 60
  },
  "assets": {
    "css": ["widget.css"],
    "js": ["class.widget.js"]
  }
}
